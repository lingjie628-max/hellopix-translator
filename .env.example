# Node 仅监听本机，由 Nginx 对外提供 HTTPS。
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# 多个来源用英文逗号分隔；同域部署可留空。
ALLOWED_ORIGINS=https://pix.example.com

# Electron 正式线路也必须使用同一个 HTTPS 域名。
PIX_PUBLIC_URL=https://pix.example.com

# PostgreSQL / Redis。生产环境缺少 URL、缺少密码或使用 CHANGE_ME 会拒绝初始化。
# 本机 Docker Compose 使用 disable；远程 PostgreSQL 必须使用 verify-full 并配置 CA。
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://hello_pix:CHANGE_ME@127.0.0.1:5432/hello_pix
DATABASE_SSL_MODE=disable
# DATABASE_SSL_CA_FILE=/etc/hello-pix/postgres-ca.pem
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_APPLICATION_NAME=hello-pix

REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
# 会话/限流/缓存已自带 pix: 前缀；这里留空避免二次拼接。
REDIS_KEY_PREFIX=
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=2

# 桌面端仅信任这些 API / 下载主机，多个主机用英文逗号分隔。
PIX_ALLOWED_API_HOSTS=pix.example.com
PIX_ALLOWED_DOWNLOAD_HOSTS=download.pix.example.com

# 仅本地开发需要演示账号时显式开启；生产环境无效。
PIX_ENABLE_DEMO_DATA=0
PIX_ENABLE_DEMO_PAYMENT=0

# seed-admin 不提供默认账号；仅在手动执行 npm run seed:admin 时临时传入。
# ADMIN_USERNAME=your-admin
# ADMIN_NICKNAME=系统管理员
# ADMIN_ROLE=superadmin
# ADMIN_PASSWORD_FILE=/run/secrets/hello-pix-admin-password
