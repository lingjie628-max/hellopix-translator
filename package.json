{
  "name": "hello-pix",
  "version": "1.1.2",
  "private": true,
  "description": "Hello Pix 翻译软件",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "serve": "vue-cli-service serve",
    "start": "vue-cli-service serve",
    "start:prod": "NODE_ENV=production node server/index.js",
    "build": "NODE_ENV=production vue-cli-service build --mode production",
    "test:security": "node scripts/run-tests.js",
    "test:strict": "PIX_TEST_STRICT=required node scripts/run-tests.js",
    "test:env": "./scripts/test-env.sh up",
    "test:integration": "node --test test/database.integration.test.js",
    "desktop": "npm start --prefix desktop",
    "telegram": "npm start --prefix standalone/telegram",
    "db:migrate": "node scripts/migrate.js up",
    "db:rollback": "node scripts/migrate.js down",
    "seed:admin": "node scripts/seed-admin.js",
    "engine:wired": "node scripts/set-engine-wired.js",
    "check:plan-copy": "node scripts/check-plan-copy.js",
    "check:dangling": "node scripts/scan-dangling.js",
    "check:unused": "node scripts/scan-unused-requires.js",
    "check:dead": "node scripts/scan-dangling.js && node scripts/scan-unused-requires.js",
    "verify:client": "node scripts/verify-preload-load.js",
    "verify:client:source": "node scripts/verify-preload-load.js --source"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "core-js": "^3.33.0",
    "element-ui": "^2.15.14",
    "express": "^5.2.1",
    "ioredis": "^5.7.0",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@vue/babel-helper-vue-jsx-merge-props": "^1.4.0",
    "@vue/babel-preset-jsx": "^1.4.0",
    "@vue/cli-plugin-babel": "^5.0.8",
    "@vue/cli-plugin-router": "^5.0.8",
    "@vue/cli-plugin-vuex": "^5.0.8",
    "@vue/cli-service": "^5.0.8",
    "jsdom": "^30.1.2",
    "vue-template-compiler": "^2.7.16"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
