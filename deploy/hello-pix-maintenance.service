[Unit]
Description=Hello Pix · 消息分区维护（提前建分区 + 清理过期分区）
Documentation=file:/opt/hello-pix/scripts/maintenance.js
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=/opt/hello-pix
# 走统一包装：独立日志 + 时间/退出码/耗时 + 体积保护
ExecStart=/opt/hello-pix/deploy/ops-run.sh maintenance /var/log/hello-pix/maintenance.log \
  /opt/hello-pix/deploy/with-env.sh /usr/bin/node scripts/maintenance.js --apply
TimeoutStartSec=600
# 部署替换 scripts/ 的极短窗口若刚好撞上 timer，单元会 203/EXEC。
# 维护脚本本身幂等，失败后自动重试一次，避免一次瞬时碰撞把
# host-health 的 systemctl --failed 一直点亮到下一个整点。
Restart=on-failure
RestartSec=30s
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hello-pix-maintenance
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
