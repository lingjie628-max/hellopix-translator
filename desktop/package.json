{
  "name": "hello-pix-desktop",
  "productName": "Hello Pix",
  "version": "0.1.25",
  "private": true,
  "description": "Hello Pix 桌面客户端",
  "author": "Hello Pix",
  "main": "main.js",
  "dependencies": {
    "undici": "^6.29.0"
  },
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac --publish never",
    "pack:mac:release": "PIX_REQUIRE_NOTARIZED=1 electron-builder --mac --publish never",
    "pack:win": "electron-builder --win --publish never",
    "pack:all": "electron-builder --mac --win --publish never",
    "pack:dir": "electron-builder --dir --publish never",
    "verify:proxy": "env -u ELECTRON_RUN_AS_NODE electron scripts/proxy-mechanism-electron.js",
    "verify:native-input": "env -u ELECTRON_RUN_AS_NODE electron scripts/verify-native-input-electron.js",
    "verify:concurrency": "env -u ELECTRON_RUN_AS_NODE electron scripts/verify-concurrency.js",
    "verify:settle-safety": "env -u ELECTRON_RUN_AS_NODE electron scripts/verify-settle-safety.js",
    "verify:api-net": "env -u ELECTRON_RUN_AS_NODE electron scripts/verify-api-net-electron.js",
    "bench:send": "env -u ELECTRON_RUN_AS_NODE electron scripts/bench-send-timing.js",
    "bench:translate:live": "env -u ELECTRON_RUN_AS_NODE electron scripts/bench-translate-live.js"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hellopix.desktop",
    "productName": "Hello Pix",
    "copyright": "Copyright © 2026 Hello Pix",
    "extraMetadata": {
      "pixPublicUrl": "https://pixfanyi.com"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/after-pack.js",
    "afterSign": "scripts/after-sign.js",
    "files": [
      "main.js",
      "preload.js",
      "guest-inject.js",
      "lines.js",
      "api-default.js",
      "platforms.js",
      "security-policy.js",
      "proxy-presets.js",
      "proxy-settings.js",
      "proxy-isolation.js",
      "socks-relay.js",
      "probe-page.js",
      "instance-slot.js",
      "background-mode.js",
      "log-file.js",
    "bridge-warning.js",
      "native-composer.js",
      "package.json",
      "node_modules/undici/**/*",
      "renderer/**/*",
      "!renderer/*.mp4",
      "!renderer/*.m4v",
      "!renderer/icon.iconset/**",
      "!**/.DS_Store",
      "!**/.stage/**",
      "!**/.cache/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "Hello Pix ${version}",
      "window": {
        "width": 620,
        "height": 470
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 330,
          "type": "file",
          "path": "build/首次打开说明.txt"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hello Pix",
      "artifactName": "HelloPix-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "target": [
        "AppImage"
      ]
    }
  }
}
